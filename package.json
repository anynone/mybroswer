{
  "name": "polaris-browser",
  "productName": "Polaris 浏览器",
  "version": "0.1.0",
  "description": "基于最新 Chromium 内核的自定义浏览器：User-Agent/请求头与真实 Chrome 完全一致，支持自定义时区（不跟随系统时区）",
  "main": "src/main/main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke",
    "shot": "electron . --shot",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "adm-zip": "^0.6.1"
  },
  "build": {
    "appId": "com.polaris.browser",
    "productName": "Polaris",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "ui/**/*",
      "extensions.json",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
  }
}
